<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Existing properties unchanged -->
    <!-- Add core console logging pattern -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] %-40.40logger{39} : %m%n%ex"/>

    <!-- New Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Hibernate SQL globally -->
    <logger name="org.hibernate.SQL" level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Spring Framework logs globally -->
    <logger name="org.springframework" level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.carddemo" level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- ROOT LOGGER (Global, for all profiles) -->
    <root level="INFO">
        <appender-ref ref="ASYNC_APPLICATION"/>
        <appender-ref ref="ERROR_APPENDER"/>
    </root>

    <!-- DEVELOPMENT PROFILE -->
    <springProfile name="development">
        <!-- In development: force root to DEBUG -->
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APPLICATION"/>
            <appender-ref ref="ERROR_APPENDER"/>
        </root>

        <!-- Explicitly enable console output for key loggers -->
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="true">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_PERFORMANCE"/>
        </logger>

        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="true">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_PERFORMANCE"/>
        </logger>

        <logger name="org.springframework" level="DEBUG" additivity="true">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APPLICATION"/>
        </logger>

        <logger name="com.carddemo" level="DEBUG" additivity="true">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APPLICATION"/>
        </logger>
    </springProfile>

    <!-- Keep your staging, production, test profiles unchanged -->
    <!-- Keep all file appenders (application.log, audit.log, security.log, performance.log, error.log) untouched -->
    <!-- Keep all masking, MDC, JSON encoders, and rotation policies as-is -->

</configuration>
